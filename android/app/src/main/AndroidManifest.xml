<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- 2.5：桌面圖示改由下面的「入口別名」提供（可在設定裡換圖示），這裡不再放 LAUNCHER -->
        </activity>

        <!-- 2.5 手機桌面 App 圖示：每種圖示一個入口別名，同時只開一個（LedgerWidgetPlugin.setAppIcon 切換）。預設開原版 -->
        <activity-alias android:name=".Icon_original" android:targetActivity=".MainActivity" android:enabled="true" android:exported="true"
            android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:label="@string/title_activity_main">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_cry" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_cry" android:roundIcon="@mipmap/ic_launcher_cry" android:label="@string/title_activity_main">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_happy" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_happy" android:roundIcon="@mipmap/ic_launcher_happy" android:label="@string/title_activity_main">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_shock" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_shock" android:roundIcon="@mipmap/ic_launcher_shock" android:label="@string/title_activity_main">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_cool" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_cool" android:roundIcon="@mipmap/ic_launcher_cool" android:label="@string/title_activity_main">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_love" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_love" android:roundIcon="@mipmap/ic_launcher_love" android:label="@string/title_activity_main">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_note" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_note" android:roundIcon="@mipmap/ic_launcher_note" android:label="@string/title_activity_main">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>

        <!-- 桌面小工具（第七批） -->
        <receiver
            android:name=".LedgerWidgetProvider"
            android:label="@string/app_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ledger_info" />
        </receiver>

        <!-- 通知欄快捷列（2.3）：開機、更新後、午夜、改時間時重新發出 -->
        <receiver
            android:name=".QuickBarReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="tw.pk.ledger.BAR_MIDNIGHT" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 2.3：點小工具條碼複製載具時輕震動一下 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 2.3：通知欄快捷列（Android 13 以上要使用者允許通知；開機後重新發出） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
