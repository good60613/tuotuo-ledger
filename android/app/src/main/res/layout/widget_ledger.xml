<?xml version="1.0" encoding="utf-8"?>
<!-- 拖拖記帳桌面小工具 3×2（第七批）。上半條碼、下半金額；尺寸在 values/widget_dimens.xml，顏色在 values/widget_colors.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="@dimen/widget_padding">

    <!-- 上半：載具條碼 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/widget_code_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_code_bg"
            android:padding="@dimen/widget_code_box_padding">

            <ImageView
                android:id="@+id/widget_code"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="@string/widget_code_desc" />

            <TextView
                android:id="@+id/widget_code_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textSize="@dimen/widget_code_text"
                android:letterSpacing="0.15"
                android:fontFamily="monospace" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_code_hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="@drawable/widget_hint_bg"
            android:text="@string/widget_no_carrier"
            android:textColor="@color/widget_muted"
            android:textSize="@dimen/widget_small"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 下半：剩餘可用（大）＋今日、本月支出（小）＋角落圖示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap"
        android:orientation="horizontal"
        android:gravity="bottom">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_left_label"
                android:textColor="@color/widget_muted"
                android:textSize="@dimen/widget_label" />

            <TextView
                android:id="@+id/widget_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="@dimen/widget_left"
                android:textStyle="bold"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <ImageView
                android:id="@+id/widget_icon"
                android:scaleType="fitCenter"
                android:layout_width="@dimen/widget_icon"
                android:layout_height="@dimen/widget_icon"
                android:layout_marginBottom="@dimen/widget_icon_gap"
                android:src="@mipmap/ic_launcher_round"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_today_label"
                    android:textColor="@color/widget_muted"
                    android:textSize="@dimen/widget_small" />
                <TextView
                    android:id="@+id/widget_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_expense"
                    android:textSize="@dimen/widget_small"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_month_label"
                    android:textColor="@color/widget_muted"
                    android:textSize="@dimen/widget_small" />
                <TextView
                    android:id="@+id/widget_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_expense"
                    android:textSize="@dimen/widget_small"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_stale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_stale"
                android:textColor="@color/widget_muted"
                android:textSize="@dimen/widget_label"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>