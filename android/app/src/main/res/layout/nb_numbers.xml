<?xml version="1.0" encoding="utf-8"?>
<!-- 通知欄快捷列第一排（2.3）：剩餘可用｜今日支出｜今日收入 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nb_left"
            android:textColor="@color/nb_text_secondary"
            android:textSize="11sp" />
        <!-- 剩餘可用：平常用主要文字色；負數時改顯示紅色那顆（兩顆疊在一起，程式只切換顯示）。
             顏色全部由資源決定，系統切換淺色／深色時會跟著換 -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/nb_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nb_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1" />
            <TextView
                android:id="@+id/nb_left_neg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textColor="@color/nb_expense"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nb_expense"
            android:textColor="@color/nb_text_secondary"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/nb_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/nb_expense"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nb_income"
            android:textColor="@color/nb_text_secondary"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/nb_income"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/nb_income"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
