<?xml version="1.0" encoding="utf-8"?>
<!-- 通知欄快捷列第一排（2.3）：剩餘可用｜今日支出｜今日收入 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nb_left"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/nb_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nb_expense"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/nb_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D64545"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nb_income"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/nb_income"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#14996A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
